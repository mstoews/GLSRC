//
// port.rc - the resources the port adds, which have no original template
// (spec #3 3), and the UI refresh's toolbar tooltips and icons
// (icons/fluent/icons.rc, generated). Written by hand; gl/res/tools/prune_rc.py
// #includes it at the end of the generated gl.rc. IDs are in gl/port/PortIds.h.
//
// Keep this file plain ASCII: gl.rc is UTF-16, and rc.exe reads an included
// file in the build's code page.
//
// New dialogs use Segoe UI 9, as every generated dialog does since the UI
// refresh (specs/2026-11-13-ui-refresh-design.md 4.1, D1), and standard
// controls. Add each one to /checkres (gl/port/ResourceCheck.cpp), whose text
// fit check measures its captions.
//
#include "..\port\PortIds.h"

// ---- Sample Report options (S3-M1) -----------------------------------------
// The report engine's test report: gl.exe /samplereport (gl/README.md, Checks).

IDD_SAMPLE_OPTIONS DIALOGEX 0, 0, 220, 96
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sample Report"
FONT 9, "Segoe UI"
{
 AUTOCHECKBOX "Include accounts with a &zero balance", IDC_SAMPLE_ZEROS, 10, 10, 200, 10
 AUTOCHECKBOX "&Landscape", IDC_SAMPLE_LANDSCAPE, 10, 26, 200, 10
 LTEXT "&Repeat the list (1-50 times, to make pages):", -1, 10, 45, 150, 8
 EDITTEXT IDC_SAMPLE_REPEAT, 164, 43, 30, 12, ES_NUMBER | WS_TABSTOP
 DEFPUSHBUTTON "OK", IDOK, 108, 72, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 162, 72, 50, 14
}

// ---- Trial balance options (S3-M2, spec #3 5.6) ------------------------------
// F1 Trial Balance (6076) hides the To period and the voucher lines; the
// caption and labels are set by code (gl/port/reports/ReportOptions.cpp).

IDD_TB_OPTIONS DIALOGEX 0, 0, 232, 112
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Trial Balance"
FONT 9, "Segoe UI"
{
 LTEXT "&From period:", IDC_TB_FROM_LABEL, 10, 12, 60, 8
 COMBOBOX IDC_TB_FROM, 74, 10, 148, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "&To period:", IDC_TB_TO_LABEL, 10, 30, 60, 8
 COMBOBOX IDC_TB_TO, 74, 28, 148, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Show &voucher lines", IDC_TB_LINES, 10, 50, 212, 10
 AUTOCHECKBOX "&Include accounts with no balance or activity", IDC_TB_ZEROS, 10, 64, 212, 10
 DEFPUSHBUTTON "OK", IDOK, 118, 88, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 172, 88, 50, 14
}

// ---- Financial statement options (S3-M3, spec #3 5.6) ------------------------
// F3 Income Statement uses every control; F4 Balance Sheet and F5 Cash Flow
// Statement hide the department and the comparisons. The caption is set by
// code (gl/port/reports/ReportOptions.cpp).

IDD_STMT_OPTIONS DIALOGEX 0, 0, 252, 140
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Financial Statement"
FONT 9, "Segoe UI"
{
 LTEXT "&Period:", -1, 10, 12, 60, 8
 COMBOBOX IDC_ST_PERIOD, 74, 10, 168, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "&Department:", IDC_ST_DEPT_LABEL, 10, 30, 60, 8
 COMBOBOX IDC_ST_DEPT, 74, 28, 168, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Compare with the p&rior year", IDC_ST_PRIOR, 10, 50, 232, 10
 AUTOCHECKBOX "Compare with the &budget", IDC_ST_BUDGET, 10, 64, 232, 10
 AUTOCHECKBOX "Show the &accounts under each line", IDC_ST_ACCOUNTS, 10, 82, 232, 10
 AUTOCHECKBOX "Show &zero lines", IDC_ST_ZEROS, 10, 96, 232, 10
 DEFPUSHBUTTON "OK", IDOK, 138, 118, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 192, 118, 50, 14
}

// ---- Accounts > Statement Layout (spec #3 6.4; plan S3-M4) -----------------
// The grid shows the statement's lines; the selected line's fields are edited
// in the controls under it (fx::Grid needs no text editing).
IDD_STMT_LAYOUT DIALOGEX 0, 0, 420, 270
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Statement Layout"
FONT 9, "Segoe UI"
{
 LTEXT "&Statement:", -1, 7, 9, 42, 8
 COMBOBOX IDC_SL_STATEMENT, 52, 7, 150, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "", IDC_SL_GRID, "tbSpread", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 7, 24, 406, 128
 GROUPBOX " Line ", -1, 7, 156, 406, 86
 LTEXT "&No.:", -1, 14, 170, 22, 8
 EDITTEXT IDC_SL_LINENO, 40, 168, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "&Kind:", -1, 80, 170, 22, 8
 COMBOBOX IDC_SL_KIND, 104, 168, 90, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Si&gn:", -1, 204, 170, 22, 8
 COMBOBOX IDC_SL_SIGN, 228, 168, 44, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "&Indent:", -1, 282, 170, 28, 8
 COMBOBOX IDC_SL_INDENT, 312, 168, 36, 80, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "Cap&tion:", -1, 14, 188, 34, 8
 EDITTEXT IDC_SL_CAPTION, 52, 186, 354, 12, ES_AUTOHSCROLL
 LTEXT "&Formula:", -1, 14, 206, 34, 8
 EDITTEXT IDC_SL_FORMULA, 52, 204, 120, 12, ES_AUTOHSCROLL
 LTEXT "&Ranges:", -1, 180, 206, 30, 8
 EDITTEXT IDC_SL_RANGES, 214, 204, 192, 12, ES_AUTOHSCROLL
 PUSHBUTTON "&Add", IDC_SL_ADD, 52, 222, 50, 14
 PUSHBUTTON "Insert &before", IDC_SL_INSERT, 106, 222, 60, 14
 PUSHBUTTON "&Delete", IDC_SL_DELETE, 170, 222, 50, 14
 PUSHBUTTON "A&pply", IDC_SL_APPLY, 224, 222, 50, 14
 PUSHBUTTON "&Check", IDC_SL_CHECK, 7, 248, 50, 14
 PUSHBUTTON "Pre&view", IDC_SL_PREVIEW, 61, 248, 50, 14
 PUSHBUTTON "Reset to defa&ult", IDC_SL_RESET, 115, 248, 70, 14
 PUSHBUTTON "Sav&e", IDC_SL_SAVE, 309, 248, 50, 14
 PUSHBUTTON "Close", IDCANCEL, 363, 248, 50, 14
}

// ---- the frame's toolbar tooltips (UI refresh spec 4.3; ManilaGL.cpp) -----
// Each names what its button opens, as the menu does.

STRINGTABLE
{
 IDS_TIP_NEW,     "New"
 IDS_TIP_OPEN,    "Open"
 IDS_TIP_SAVE,    "Save"
 IDS_TIP_PRINT,   "Print"
 IDS_TIP_GLBATCH, "General Ledger Voucher"
 IDS_TIP_APBATCH, "Purchase Invoice Vouchers"
 IDS_TIP_CASH,    "Cash Invoice Vouchers"
 IDS_TIP_ARBATCH, "Sales Invoice Voucher"
 IDS_TIP_GLINQ,   "Chart of Accounts Report"
 IDS_TIP_GLPOST,  "Post General Ledger Voucher"
 IDS_TIP_GLADD,   "Chart of Accounts"
 IDS_TIP_EXIT,    "Exit"
}

// ---- UI refresh icons (specs/2026-11-13-ui-refresh-design.md 4.2) ----------
// P<resource>: shown instead of bitmap <resource> (SuperBtn.cpp). Generated by
// gl/res/tools/make_icons.py from icons/fluent/map.csv.

#include "icons/fluent/icons.rc"

// ---- Receipts/Payments > Confirm Printed Cheques (spec #5 6.2, D9; plan S5-M6) ----
// Replaces Set Cheque Numbers (1157), which zapped AP_REQST and renumbered
// every cheque: the cheques made and not yet confirmed are listed; Confirm
// marks a range printed, and Renumber gives a spoiled one a new number.
IDD_AP_CONFIRM DIALOGEX 0, 0, 300, 196
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm Printed Cheques"
FONT 9, "Segoe UI"
{
 LTEXT "Cheques made, not yet confirmed printed:", -1, 7, 7, 200, 9
 CONTROL "", IDC_APC_GRID, "tbSpread", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 7, 18, 286, 100
 LTEXT "Printed correctly: cheques &from", -1, 7, 128, 110, 9
 EDITTEXT IDC_APC_FROM, 120, 126, 46, 13, ES_NUMBER | WS_TABSTOP
 LTEXT "&to", -1, 172, 128, 12, 9
 EDITTEXT IDC_APC_TO, 186, 126, 46, 13, ES_NUMBER | WS_TABSTOP
 DEFPUSHBUTTON "&Confirm", IDOK, 238, 125, 55, 14
 LTEXT "Spoiled: the selected cheque's &new number", -1, 7, 150, 150, 9
 EDITTEXT IDC_APC_NEWNO, 160, 148, 46, 13, ES_NUMBER | WS_TABSTOP
 PUSHBUTTON "&Renumber", IDC_APC_RENUMBER, 238, 147, 55, 14
 PUSHBUTTON "Close", IDCANCEL, 238, 175, 55, 14
}

// ---- the report writer's designer (spec #7 6.2, D5; plan S7-M2) ----------
// Reporting > Custom Report: Add, Modify and Copy open it on a definition
// (ReportDesigner.cpp). Preview runs it as it stands; Save checks and saves.

IDD_RW_DESIGN DIALOGEX 0, 0, 470, 316
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Report Designer"
FONT 9, "Segoe UI"
{
 LTEXT "&Name:", -1, 7, 9, 42, 8
 EDITTEXT IDC_RW_NAME, 52, 7, 150, 12, ES_AUTOHSCROLL
 LTEXT "&Title:", -1, 212, 9, 30, 8
 EDITTEXT IDC_RW_TITLE, 244, 7, 150, 12, ES_AUTOHSCROLL
 AUTOCHECKBOX "&Landscape", IDC_RW_LANDSCAPE, 402, 8, 62, 10
 LTEXT "&Description:", -1, 7, 25, 44, 8
 EDITTEXT IDC_RW_DESCRIPTION, 52, 23, 150, 12, ES_AUTOHSCROLL
 LTEXT "Su&btitle:", -1, 212, 25, 30, 8
 EDITTEXT IDC_RW_SUBTITLE, 244, 23, 150, 12, ES_AUTOHSCROLL
 LTEXT "&Source:", -1, 7, 41, 42, 8
 COMBOBOX IDC_RW_SOURCE, 52, 39, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", IDC_RW_SOURCEINFO, 212, 39, 252, 20
 GROUPBOX " Columns ", -1, 7, 62, 456, 108
 LTEXT "&Fields:", -1, 14, 74, 60, 8
 LISTBOX IDC_RW_FIELDS, 14, 84, 130, 80, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
 PUSHBUTTON "&Add >", IDC_RW_ADDCOL, 150, 90, 50, 14
 PUSHBUTTON "< &Remove", IDC_RW_REMOVECOL, 150, 108, 50, 14
 PUSHBUTTON "&Up", IDC_RW_UP, 150, 126, 50, 14
 PUSHBUTTON "Do&wn", IDC_RW_DOWN, 150, 144, 50, 14
 LTEXT "Colu&mns:", -1, 206, 74, 60, 8
 LISTBOX IDC_RW_COLUMNS, 206, 84, 130, 80, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
 LTEXT "Lab&el:", -1, 344, 86, 26, 8
 EDITTEXT IDC_RW_COLLABEL, 372, 84, 84, 12, ES_AUTOHSCROLL
 LTEXT "W&idth:", -1, 344, 102, 26, 8
 EDITTEXT IDC_RW_COLWIDTH, 372, 100, 30, 12, ES_AUTOHSCROLL
 AUTOCHECKBOX "T&otal", IDC_RW_COLTOTAL, 344, 118, 60, 10
 AUTOCHECKBOX "Blan&k when zero", IDC_RW_COLBLANK, 344, 132, 90, 10
 GROUPBOX " Sort and group ", -1, 7, 174, 456, 48
 LTEXT "Sort by:", -1, 14, 188, 36, 8
 COMBOBOX IDC_RW_SORT1, 52, 186, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "desc.", IDC_RW_DESC1, 146, 187, 30, 10
 COMBOBOX IDC_RW_SORT2, 182, 186, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "desc.", IDC_RW_DESC2, 276, 187, 30, 10
 COMBOBOX IDC_RW_SORT3, 312, 186, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "desc.", IDC_RW_DESC3, 406, 187, 30, 10
 LTEXT "Group by:", -1, 14, 206, 36, 8
 COMBOBOX IDC_RW_GROUP1, 52, 204, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "new page", IDC_RW_PAGE1, 146, 205, 44, 10
 COMBOBOX IDC_RW_GROUP2, 196, 204, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "new page", IDC_RW_PAGE2, 290, 205, 44, 10
 GROUPBOX " Filters ", -1, 7, 226, 456, 62
 LISTBOX IDC_RW_FILTERS, 14, 238, 200, 44, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
 COMBOBOX IDC_RW_FFIELD, 220, 238, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 COMBOBOX IDC_RW_FTEST, 314, 238, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 EDITTEXT IDC_RW_FVALUE1, 378, 238, 40, 12, ES_AUTOHSCROLL
 EDITTEXT IDC_RW_FVALUE2, 420, 238, 36, 12, ES_AUTOHSCROLL
 PUSHBUTTON "Add filter", IDC_RW_FADD, 220, 256, 60, 14
 PUSHBUTTON "Remove filter", IDC_RW_FREMOVE, 284, 256, 64, 14
 LTEXT "For ""one of"", separate the values with commas.", -1, 220, 274, 236, 8
 AUTOCHECKBOX "&Grand total", IDC_RW_GRANDTOTAL, 7, 297, 60, 10
 AUTOCHECKBOX "Row &counts", IDC_RW_COUNT, 72, 297, 60, 10
 PUSHBUTTON "&Preview", IDC_RW_PREVIEW, 300, 294, 50, 14
 PUSHBUTTON "Sa&ve", IDC_RW_SAVE, 354, 294, 50, 14
 PUSHBUTTON "Close", IDCANCEL, 408, 294, 55, 14
}
